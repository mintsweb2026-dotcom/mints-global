# ==============================================================================
# Mints Global Web Platform - Environment Variables Template
# Copy this file to `.env.local` for local development.
# Do NOT commit `.env.local` or any sensitive credentials to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# EmailJS Configuration (Client-side contact form dispatch)
# ------------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID="service_placeholder"
VITE_EMAILJS_TEMPLATE_ID="template_placeholder"
VITE_EMAILJS_PUBLIC_KEY="public_key_placeholder"

# ------------------------------------------------------------------------------
# Google Analytics 4
# ------------------------------------------------------------------------------
VITE_GA_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# Firebase Configuration (Firestore Blog, Portfolio Works, Admin Auth)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# Live Chat (Crisp Chat Widget - Optional)
# ------------------------------------------------------------------------------
VITE_CRISP_WEBSITE_ID="3590cc65-c43f-4ce9-98cf-ddd1f75f853c"

# ------------------------------------------------------------------------------
# Error Tracking & Telemetry (Optional - Sentry or compatible endpoint)
# ------------------------------------------------------------------------------
VITE_SENTRY_DSN=""

