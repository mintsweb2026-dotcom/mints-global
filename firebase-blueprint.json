{
  "entities": {
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "content", "authorId", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with admin privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "posts": {
      "schema": "BlogPost",
      "description": "Stores blog posts"
    },
    "admins": {
      "schema": "Admin",
      "description": "Stores admin records"
    }
  }
}
