{
  "version": 2,
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ot-security-article-path",
      "destination": "/blog/ot-security",
      "permanent": true
    }
  ]
}
