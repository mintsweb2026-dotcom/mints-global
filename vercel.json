{
  "version": 2,
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/ot-security-article-path",
      "destination": "/blog/ot-security",
      "permanent": true
    }
  ]
}
